#!/usr/bin/env bash
# Путь для Windows-процесса (окно meeting): из Git Bash — cygpath -w, из WSL — wslpath -w, иначе как есть.
#
# Явно, а не на авось: Git Bash сам переделывает похожие на путь переменные, когда запускает Windows-программу,
# но правило у него неявное (/c/x → C:/x), а путь из /tmp Windows-процессу вовсе не известен. Порядок проверки
# в настоящих оболочках роли не играет: в WSL нет cygpath, в Git Bash — wslpath.
#
# windows-path <путь>
set -euo pipefail

[ $# -eq 1 ] || { echo "windows-path <путь>" >&2; exit 2; }

if command -v cygpath > /dev/null; then
    cygpath -w "$1"
elif command -v wslpath > /dev/null; then
    wslpath -w "$1"
else
    printf '%s\n' "$1"
fi
