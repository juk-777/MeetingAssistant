#!/usr/bin/env bash
# Каталог встречи для скилла /meeting: из аргумента или из current.json в корне встреч.
#
# Корень встреч — $MEETINGS_ROOT, иначе переменная пользователя Windows Storage__MeetingsRoot, которую задаёт
# установка (scripts/install.ps1) и читает сама запись. Она читается из реестра, а не из окружения: окружение WSL
# и уже открытых окон не видит переменную, заданную после их запуска.
# Корень встреч, по которому ждёт meeting-start, тот передаёт и окну записи: источник у них один — этот скрипт.
#
# Путь печатается так, как его видит эта оболочка: путь Windows (D:\…), который пишет процесс записи под Windows,
# в WSL переводится через wslpath. Отказ — код 1 и текст на stderr: что задать или запустить.
#
# meeting-dir [каталог встречи]
# meeting-dir --root — сам корень встреч, локальным путём (его ждёт meeting-start)
set -euo pipefail

fail() {
    printf '%s\n' "$1" >&2
    exit 1
}

to_local() {
    if [[ $1 =~ ^[A-Za-z]:[\\/] ]] && command -v wslpath >/dev/null; then
        wslpath -u "$1"
    else
        printf '%s\n' "$1"
    fi
}

# Значение Storage__MeetingsRoot пользователя Windows (из реестра, %…% раскрыты); нет powershell.exe или значения —
# пусто. Через PowerShell с выводом в UTF-8, а не reg.exe: тот пишет в кодовой странице консоли (кириллица
# в пути не доходит), а под Git Bash его ключ /v превращается в путь.
windows_root() {
    command -v powershell.exe >/dev/null || return 0
    { powershell.exe -NoProfile -NonInteractive -Command '
[Console]::OutputEncoding = [Text.Encoding]::UTF8
[Environment]::GetEnvironmentVariable("Storage__MeetingsRoot", "User")' 2>/dev/null || true; } | tr -d '\r'
}

meetings_root() {
    local root=${MEETINGS_ROOT:-}
    [ -n "$root" ] || root=$(windows_root)
    [ -n "$root" ] ||
        fail "Не найден корень встреч: нет ни MEETINGS_ROOT, ни переменной пользователя Windows Storage__MeetingsRoot. Установить приложение (scripts/install.ps1 задаёт её) или передать каталог встречи: /meeting <каталог>."
    to_local "$root"
}

if [ "${1:-}" = "--root" ]; then
    meetings_root
    exit 0
fi

if [ $# -gt 0 ]; then
    dir=$(to_local "$1")
else
    current="$(meetings_root)/current.json"
    [ -f "$current" ] ||
        fail "Нет $current: встреча ещё не начиналась. Запустить запись (meeting start или meeting replay) и повторить."
    command -v jq >/dev/null || fail "Нужен jq: он читает $current."
    directory=$(jq -er '.directory' "$current") || fail "В $current нет поля directory."
    dir=$(to_local "$directory")
fi

[ -d "$dir" ] || fail "Нет каталога встречи: $dir"
cd "$dir" && pwd
