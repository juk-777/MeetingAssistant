#!/usr/bin/env bash
# Запуск записи встречи из сессии: meeting start в отдельном окне Windows, затем каталог новой встречи.
#
# Окно своё, а не фоновый процесс: в нём видны устройства и то, что запись идёт; остановка — Ctrl+C или закрытие
# окна. Новая встреча узнаётся по current.json с другим id: прошлая встреча за новую не сойдёт, даже если запуск
# не удался. Ждать — до MEETING_START_TIMEOUT секунд (умолчание 60: загрузка модели).
#
# Код 3 — приложение записи не установлено (нет корня встреч или meeting.exe): скилл предлагает meeting-install.
#
# meeting.exe — по месту установки (install.ps1), а не из PATH, и каталог моделей перечитывается из реестра:
# окружение WSL и уже открытых окон не видит того, что установка задала после их старта. Корень встреч окну
# передаётся тот же, по которому скрипт ждёт новую встречу (meeting-dir --root), — иначе запись легла бы в один
# корень, а ожидание шло бы в другом.
#
# meeting-start <имя> [файл словаря]
set -euo pipefail

fail() {
    printf '%s\n' "$1" >&2
    exit 1
}

[ $# -ge 1 ] && [ $# -le 2 ] || { echo "meeting-start <имя> [файл словаря]" >&2; exit 2; }
[[ $1 != *[\"%]* && $1 != *\\ ]] ||
    fail "Имя встречи — без двойных кавычек, % и \\ в конце: их разбирает командная строка Windows."

here="$(cd "$(dirname "$0")" && pwd)"
command -v powershell.exe > /dev/null || fail "Нет powershell.exe: запись запускается только под Windows (из WSL или Git Bash)."

root=$(bash "$here/meeting-dir" --root)
previous=$(bash "$here/current-field" "$root/current.json" id 2>/dev/null || true)
window_root=$(bash "$here/windows-path" "$root")

glossary=""
if [ $# -eq 2 ]; then
    [ -f "$2" ] || fail "Нет файла словаря: $2"
    glossary=$(bash "$here/windows-path" "$2")
fi

# Имя, словарь и корень — переменными окружения, а не в командной строке PowerShell: кавычки и кириллица не ломают
# команду.
export MEETING_START_NAME=$1 MEETING_START_GLOSSARY=$glossary MEETING_START_ROOT=$window_root
export WSLENV="${WSLENV:+$WSLENV:}MEETING_START_NAME:MEETING_START_GLOSSARY:MEETING_START_ROOT"

powershell.exe -NoProfile -NonInteractive -Command '
$ErrorActionPreference = "Stop"
$env:Storage__MeetingsRoot = $env:MEETING_START_ROOT
$env:Speech__ModelsDirectory = [Environment]::GetEnvironmentVariable("Speech__ModelsDirectory", "User")
$meeting = Join-Path $env:LOCALAPPDATA "MeetingAssistant\app\meeting.exe"
if (-not (Test-Path $meeting)) { [Console]::Error.WriteLine("Приложение записи не установлено: нет $meeting. Поставить — meeting-install."); exit 3 }
$command = "`"$meeting`" start `"$env:MEETING_START_NAME`""
if ($env:MEETING_START_GLOSSARY) { $command += " --glossary `"$env:MEETING_START_GLOSSARY`"" }
# Claude Code для Windows запускает Git Bash новой группой процессов, то есть с выключенным Ctrl+C, и этот флаг
# наследуют все потомки — окно записи тоже. Снять его здесь: окно получает его от этого процесса.
Add-Type -Namespace MeetingAssistant -Name Console -MemberDefinition "[DllImport(`"kernel32.dll`")] public static extern bool SetConsoleCtrlHandler(IntPtr handler, bool add);"
[MeetingAssistant.Console]::SetConsoleCtrlHandler([IntPtr]::Zero, $false) | Out-Null
# Через cmd /c и pause всегда: окно не закрывается ни при отказе (видна причина), ни после Ctrl+C (виден итог —
# строки, события, CPU и пик памяти встречи есть только в нём).
Start-Process -FilePath cmd.exe -ArgumentList "/c `"$command & pause`"" -WorkingDirectory $env:USERPROFILE
' && opened=0 || opened=$?
# Код 3 — приложение записи не установлено: скилл по нему предлагает установку.
[ "$opened" -ne 3 ] || exit 3
[ "$opened" -eq 0 ] || fail "Окно записи не открылось."

deadline=$((SECONDS + ${MEETING_START_TIMEOUT:-60}))
while [ $SECONDS -lt $deadline ]; do
    id=$(bash "$here/current-field" "$root/current.json" id 2>/dev/null || true)
    if [ -n "$id" ] && [ "$id" != "$previous" ]; then
        exec bash "$here/meeting-dir"
    fi
    sleep 0.5
done

fail "Новая встреча не началась за ${MEETING_START_TIMEOUT:-60} с: причина — в окне meeting (настройки, модель, устройства)."
