#!/usr/bin/env bash
# Уточнение встречи из сессии: meeting refine в отдельном окне Windows, затем каталог встречи — и сразу выход.
#
# Окно своё, а не фоновый процесс сессии: час встречи — около 40 минут работы, в окне виден ход, а сессия свободна.
# После итога или отказа окно ждёт клавишу. Готовый transcript.whisper.md появляется только по окончании.
#
# Встреча без «конец записи» в events.log ещё пишется (или оборвалась аварийно) — отказ здесь, а не в окне: сессия
# узнаёт его сразу. Ту же проверку делает и meeting refine.
#
# Код 3 — приложение записи не установлено (нет корня встреч или meeting.exe) или поставлено без модели Whisper:
# скилл предлагает meeting-install, она же обновляет установленное.
# Код 4 — приложение старее плагина (check-app-version): скилл предлагает обновить его тем же meeting-install.
#
# meeting-refine [каталог встречи]
set -euo pipefail

fail() {
    printf '%s\n' "$1" >&2
    exit 1
}

[ $# -le 1 ] || { echo "meeting-refine [каталог встречи]" >&2; exit 2; }

here="$(cd "$(dirname "$0")" && pwd)"
command -v powershell.exe > /dev/null || fail "Нет powershell.exe: уточнение запускается только под Windows (из WSL или Git Bash)."

# Отказ meeting-dir (код 3 — не установлено) выходит отсюда с тем же кодом.
dir=$(bash "$here/meeting-dir" "$@")
grep -q $'\tконец записи$' "$dir/events.log" 2>/dev/null ||
    fail "Запись встречи $dir не закончена: в events.log нет «конец записи». Остановите запись (Ctrl+C в окне meeting) и повторите."

window_dir=$(bash "$here/windows-path" "$dir")

# Код 3 или 4 (приложение старее плагина) — выход с ним же, до окна.
bash "$here/check-app-version"

# Каталог — переменной окружения, а не в командной строке PowerShell: кавычки и кириллица не ломают команду.
export MEETING_REFINE_DIR=$window_dir
export WSLENV="${WSLENV:+$WSLENV:}MEETING_REFINE_DIR"
# Git Bash переделывает похожие на путь значения переменных, когда запускает программу Windows. Каталог уже в виде
# Windows, переделывать нечего, — переменные MEETING_* как есть, как во всех скриптах скилла.
export MSYS2_ENV_CONV_EXCL="${MSYS2_ENV_CONV_EXCL:+$MSYS2_ENV_CONV_EXCL;}MEETING_"

powershell.exe -NoProfile -NonInteractive -Command '
$ErrorActionPreference = "Stop"
$env:Storage__MeetingsRoot = [Environment]::GetEnvironmentVariable("Storage__MeetingsRoot", "User")
$env:Speech__ModelsDirectory = [Environment]::GetEnvironmentVariable("Speech__ModelsDirectory", "User")
$meeting = Join-Path $env:LOCALAPPDATA "MeetingAssistant\app\meeting.exe"
if (-not (Test-Path $meeting)) { [Console]::Error.WriteLine("Приложение записи не установлено: нет $meeting. Поставить — meeting-install."); exit 3 }
# Имя модели — SpeechModels.WhisperFile; её ставит install.ps1, а установка до уточнения встречи её не ставила.
if (-not $env:Speech__ModelsDirectory) { [Console]::Error.WriteLine("Приложение записи не установлено: нет переменной Speech__ModelsDirectory. Поставить — meeting-install."); exit 3 }
$whisper = Join-Path $env:Speech__ModelsDirectory "ggml-large-v3-turbo-q5_0.bin"
if (-not (Test-Path $whisper)) { [Console]::Error.WriteLine("Нет модели Whisper ($whisper): приложение поставлено до уточнения встречи. Обновить — meeting-install."); exit 3 }
$command = "`"$meeting`" refine `"$env:MEETING_REFINE_DIR`""
# Claude Code для Windows запускает Git Bash новой группой процессов, то есть с выключенным Ctrl+C, и этот флаг
# наследуют все потомки — окно уточнения тоже. Снять его здесь: окно получает его от этого процесса.
Add-Type -Namespace MeetingAssistant -Name Console -MemberDefinition "[DllImport(`"kernel32.dll`")] public static extern bool SetConsoleCtrlHandler(IntPtr handler, bool add);"
[MeetingAssistant.Console]::SetConsoleCtrlHandler([IntPtr]::Zero, $false) | Out-Null
# pause и после итога: окно не закрывается, пока человек не увидел, чем кончилось.
Start-Process -FilePath cmd.exe -ArgumentList "/c `"$command & pause`"" -WorkingDirectory $env:USERPROFILE
' && opened=0 || opened=$?
[ "$opened" -ne 3 ] || exit 3
[ "$opened" -eq 0 ] || fail "Окно уточнения не открылось."

printf '%s\n' "$dir"
