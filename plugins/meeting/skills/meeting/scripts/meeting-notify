#!/usr/bin/env bash
# Всплывающее уведомление с подсказкой: на созвоне в фокусе приложение звонка, а не терминал.
# Строки текста склеиваются пробелом — переносит система; показ длинный (≈ 25 с), пропущенное остаётся в центре
# уведомлений.
#
# Показывается, только если у встречи включены уведомления — в каталоге встречи есть отметка notify (ставит
# meeting-start --notify). Без неё скрипт ничего не делает: на собеседовании с показом экрана подсказка не должна
# всплыть на показанном мониторе, а полный ответ и так виден в окне подсказок и в сессии.
#
# В Windows его показывает powershell.exe (виден из WSL и из Git Bash), на Linux — notify-send, поэтому терминал,
# в котором открыта сессия, роли не играет. Нет ни того, ни другого (macOS, Linux без notify-send) — скрипт ничего
# не делает.
#
# meeting-notify <каталог встречи> <текст>
set -euo pipefail

if [ $# -ne 2 ] || [ ! -d "$1" ]; then
    echo "meeting-notify <каталог встречи> <текст>" >&2
    exit 2
fi

[ -e "$1/notify" ] || exit 0

text=${2//$'\r'/}
text=${text//$'\n'/ }

if ! command -v powershell.exe > /dev/null; then
    command -v notify-send > /dev/null || exit 0
    # Текст уведомления по спецификации freedesktop — разметка: «Task<T>» сервер счёл бы тегом и вырезал. Замены —
    # в кавычках: в bash 5.2 голый & в замене значит найденное.
    text=${text//&/"&amp;"}
    text=${text//</"&lt;"}
    text=${text//>/"&gt;"}
    # «--»: подсказка, начатая с «-», — текст, а не ключ.
    exec notify-send --app-name=MeetingAssistant --expire-time=25000 -- MeetingAssistant "$text"
fi

# Текст — переменной окружения, а не в командной строке: кавычки подсказки не ломают команду PowerShell, кириллица
# не проходит через кодовую страницу консоли. Из WSL в Windows-процесс переменная попадает, только если названа
# в WSLENV.
export MEETING_NOTIFY_TEXT=$text
export WSLENV="${WSLENV:+$WSLENV:}MEETING_NOTIFY_TEXT"
# Git Bash переделывает похожие на путь значения переменных (/x → C:/Program Files/Git/x), когда запускает программу
# Windows: подсказка «/api/… вернул 500» дошла бы искажённой. Переменные MEETING_* — как есть.
export MSYS2_ENV_CONV_EXCL="${MSYS2_ENV_CONV_EXCL:+$MSYS2_ENV_CONV_EXCL;}MEETING_"

# Уведомление показывается от имени приложения из меню «Пуск»; Windows PowerShell есть в любой Windows.
powershell.exe -NoProfile -NonInteractive -Command '
$ErrorActionPreference = "Stop"
$manager = [Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime]
$toast = $manager::GetTemplateContent([Windows.UI.Notifications.ToastTemplateType]::ToastText02)
$toast.DocumentElement.SetAttribute("duration", "long")
$texts = $toast.GetElementsByTagName("text")
$texts.Item(0).AppendChild($toast.CreateTextNode("MeetingAssistant")) | Out-Null
$texts.Item(1).AppendChild($toast.CreateTextNode($env:MEETING_NOTIFY_TEXT)) | Out-Null
$app = "{1AC14E77-02E7-4E5D-B744-2EB1AE5198B7}\WindowsPowerShell\v1.0\powershell.exe"
$manager::CreateToastNotifier($app).Show([Windows.UI.Notifications.ToastNotification]::new($toast))
'
