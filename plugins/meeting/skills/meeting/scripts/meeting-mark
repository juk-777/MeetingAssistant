#!/usr/bin/env bash
# Отметка «оцени» из чата сессии (режим собеседования, роль интервьюера): окно подсказок интервьюеру отвечает на неё,
# как на конец ответа кандидата. Пишет строку `<epoch>` в marks.log каталога встречи — events.log пишет только
# процесс записи.
#
# meeting-mark <каталог встречи>
set -euo pipefail

[ $# -eq 1 ] || { echo "meeting-mark <каталог встречи>" >&2; exit 2; }
[ -d "$1" ] || { echo "Нет каталога встречи: $1" >&2; exit 1; }

printf '%s\n' "${EPOCHREALTIME/,/.}" >> "$1/marks.log"
