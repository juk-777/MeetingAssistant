#!/usr/bin/env bash
# Строка в hints.md каталога встречи на каждое пробуждение сессии — и с подсказкой, и с молчанием.
#
# По файлу считаются задержка «событие → подсказка» и доля молчаний. Одна строка файла — одно пробуждение:
# строки подсказки склеиваются через « / », табуляции заменяются пробелом, пустой текст — молчание.
#
# meeting-hint <каталог встречи> <epoch события> <номер строки события> <текст подсказки | ->
set -euo pipefail

SILENCE="-"

if [ $# -ne 4 ]; then
    echo "meeting-hint <каталог встречи> <epoch события> <номер строки события> <текст подсказки | ->" >&2
    exit 2
fi

dir=$1
at=$2
number=$3
text=$4

[ -d "$dir" ] || { echo "Нет каталога встречи: $dir" >&2; exit 1; }

text=${text//$'\r'/}
text=${text//$'\t'/ }
text=$(printf '%s\n' "$text" | awk 'NF { printf "%s%s", separator, $0; separator = " / " }')
[ -n "$text" ] || text=$SILENCE

# Время — из bash, а не `date +%s.%3N`: uutils date ширину у %N не понимает и печатает 9 знаков. Разделитель
# дробной части у EPOCHREALTIME — по локали, в файле — точка, как у epoch процесса записи.
now=${EPOCHREALTIME/,/.}
printf '%s\t%s\t%s\t%s\n' "$at" "${now%???}" "$number" "$text" >> "$dir/hints.md"
