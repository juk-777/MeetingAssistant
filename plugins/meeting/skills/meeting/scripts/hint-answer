# Общая часть окон подсказок (meeting-candidate, meeting-interviewer): вызов модели с ответом потоком в окно,
# уведомление первой строкой, журнал, обрыв недописанного ответа. Подключается через source; до этого скрипт роли
# задаёт here, dir, transcript, events, journal, claude, model, work, answer_pid, answer_header, NO_ANSWER и функцию
# write_prompt <текст>, а правила роли кладёт в $work/rules.
#
# shellcheck shell=bash
# shellcheck disable=SC2154 # переменные задаёт скрипт роли

END_OF_RECORDING="конец записи"

# Последнюю строку процесс записи может ещё дописывать: в счёт идут только строки с переводом строки.
complete_lines() {
    if [ -f "$transcript" ]; then wc -l < "$transcript"; else echo 0; fi
}

recording_ended() {
    [ -f "$events" ] && awk -F'\t' -v end="$END_OF_RECORDING" '$3 == end { found = 1 } END { exit !found }' "$events"
}

# Текст дельт ответа из потока `--output-format stream-json`: JSON-строка поля text у text_delta, без jq — его нет в
# Git for Windows. Кириллицу CLI пишет как есть; \uXXXX собирается в байты UTF-8, поэтому awk — в локали C.
decode_stream() {
    LC_ALL=C awk '
        function hexval(s,    i, v) {
            v = 0
            for (i = 1; i <= length(s); i++) v = v * 16 + index("0123456789abcdef", tolower(substr(s, i, 1))) - 1
            return v
        }
        function utf8(code) {
            if (code < 128) return sprintf("%c", code)
            if (code < 2048) return sprintf("%c%c", 192 + int(code / 64), 128 + code % 64)
            if (code >= 55296 && code <= 57343) return ""
            return sprintf("%c%c%c", 224 + int(code / 4096), 128 + int(code / 64) % 64, 128 + code % 64)
        }
        BEGIN { marker = "\"type\":\"text_delta\",\"text\":\"" }
        {
            start = index($0, marker)
            if (start == 0) next
            s = substr($0, start + length(marker))
            out = ""
            while (length(s) > 0) {
                c = substr(s, 1, 1)
                if (c == "\"") break
                if (c == "\\") {
                    e = substr(s, 2, 1)
                    if (e == "u") { out = out utf8(hexval(substr(s, 3, 4))); s = substr(s, 7); continue }
                    if (e == "n") out = out "\n"
                    else if (e == "t") out = out "\t"
                    else if (e != "r" && e != "b" && e != "f") out = out e
                    s = substr(s, 3)
                    continue
                }
                out = out c
                s = substr(s, 2)
            }
            printf "%s", out
            fflush()
        }'
}

# Ответ на одну реплику: печать по мере прихода, уведомление первой строкой, запись в журнал. Идёт в фоне.
answer() {
    local stamp=$1 text=$2 char line="" notified=""
    : > "$work/answer"
    "$claude" -p --model "$model" --effort low --tools "" --strict-mcp-config --setting-sources "" \
        --disable-slash-commands --no-session-persistence --system-prompt-file "$work/rules" \
        --output-format stream-json --verbose --include-partial-messages < "$work/prompt" 2> "$work/error" |
        decode_stream |
        {
            while IFS= read -r -d '' -N 1 char; do
                printf '%s' "$char"
                printf '%s' "$char" >> "$work/answer"
                if [ -n "$notified" ]; then continue; fi
                if [ "$char" = $'\n' ]; then
                    notify "$line"
                    notified=1
                else
                    line+=$char
                fi
            done
            # Пустой ответ — модель не ответила (нет входа, лимит, сеть, неверная модель): причину видно, а не тишину.
            if [ ! -s "$work/answer" ]; then
                printf '(модель не ответила: %s)' "$(tr '\n' ' ' < "$work/error" | cut -c1-200)" | tee "$work/answer"
            fi
            [ -n "$notified" ] || notify "$line"
            echo
            journal_entry "$stamp" "$text" "$(< "$work/answer")"
            # Отметка вызывающего — признак, что ответ дописан, а не оборван.
            [ ! -e "$work/mark" ] || mv "$work/mark" "$work/answered"
            rm -f "$work/running"
        }
}

# Идёт ли ответ — по признаку, который ставит start_answer до запуска, а снимает сам ответ, записав журнал: конец
# записи ждёт записанного журнала, а не процесса, и признак есть с первого мгновения, ещё до того, как фон запустился.
answer_running() {
    [ -e "$work/running" ]
}

# Ответ «-» — модель решила, что отвечать не на что: уведомлять нечем.
notify() {
    [ -n "$1" ] && [ "$1" != "-" ] || return 0
    # Вход — /dev/null: фоновая задача может унаследовать поток ответа (так бывает при set -m), и powershell.exe
    # съел бы его кусок.
    bash "$here/meeting-notify" "$1" < /dev/null > /dev/null 2>&1 &
}

journal_entry() {
    local body=$3
    [ "$body" != "-" ] || body=$NO_ANSWER
    printf '## %s %s\n\n%s\n\n' "$1" "$2" "$body" >> "$journal"
}

cancel_answer() {
    [ -n "$answer_pid" ] || return 0
    if answer_running; then
        kill -- "-$answer_pid" 2> /dev/null
        wait "$answer_pid" 2> /dev/null
        rm -f "$work/running"
        echo " … (прервано)"
        journal_entry "${answer_header%%$'\t'*}" "${answer_header#*$'\t'}" "$(cat "$work/answer" 2> /dev/null) … (прервано)"
    else
        wait "$answer_pid" 2> /dev/null
    fi
    answer_pid=""
}

# start_answer <таймкод> <текст> [отметка] — отметка ляжет в $work/answered, когда ответ будет дописан.
start_answer() {
    local stamp=$1 text=$2
    cancel_answer
    if [ $# -ge 3 ]; then printf '%s' "$3" > "$work/mark"; else rm -f "$work/mark"; fi
    write_prompt "$text"
    printf '\n▶ %s %s\n' "$stamp" "$text"
    answer_header="$stamp"$'\t'"$text"
    : > "$work/running"
    # Ответ — своей группой процессов: обрыв гасит и вызов модели, и разбор его потока. set -m — только на запуск:
    # с ним скрипт отдаёт терминал каждой своей задаче и выпадает из группы переднего плана, и закрытое окно его
    # не гасит — он звал бы модель дальше без окна.
    set -m
    answer "$stamp" "$text" &
    answer_pid=$!
    set +m
}
