#!/usr/bin/env bash
# Ставит или обновляет приложение записи meeting из последнего релиза — скилл зовёт его по согласию пользователя.
#
# Качает install.ps1 релиза во временный каталог Windows и запускает его: сверку контрольных сумм, модели,
# переменные пользователя и PATH делает он. Файлом, а не через «irm | iex»: скрипт читается так же, как из
# репозитория (UTF-8 с BOM). Адрес релизов — MEETING_RELEASES (по умолчанию релизы этого репозитория на GitHub).
#
# meeting-install
set -euo pipefail

command -v powershell.exe > /dev/null ||
    { echo "Нет powershell.exe: приложение записи ставится только в Windows (из WSL или Git Bash)." >&2; exit 1; }

export MEETING_RELEASES=${MEETING_RELEASES:-https://github.com/juk-777/MeetingAssistant/releases}
export WSLENV="${WSLENV:+$WSLENV:}MEETING_RELEASES"

powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command '
$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"
[Console]::OutputEncoding = [Text.Encoding]::UTF8
[Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
$script = Join-Path $env:TEMP "meeting-assistant-install.ps1"
Invoke-WebRequest -Uri "$env:MEETING_RELEASES/latest/download/install.ps1" -OutFile $script -UseBasicParsing
& powershell.exe -NoProfile -ExecutionPolicy Bypass -File $script
exit $LASTEXITCODE
'
