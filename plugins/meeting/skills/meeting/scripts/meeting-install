#!/usr/bin/env bash
# Ставит или обновляет приложение записи meeting из последнего релиза — скилл зовёт его по согласию пользователя.
#
# В Windows (есть powershell.exe) качает install.ps1 релиза во временный каталог Windows и запускает его: сверку
# контрольных сумм, модели, переменные пользователя и PATH делает он. Файлом, а не через «irm | iex»: скрипт читается
# так же, как из репозитория (UTF-8 с BOM). На Linux так же — install.sh. Откуда брать релиз — MEETING_RELEASES:
# адрес релизов GitHub (по умолчанию — этого репозитория) или каталог с файлами релиза (в Windows — путь Windows);
# установщик получает его же.
#
# meeting-install
set -euo pipefail

export MEETING_RELEASES=${MEETING_RELEASES:-https://github.com/juk-777/MeetingAssistant/releases}

here="$(cd "$(dirname "$0")" && pwd)"
# Отказ platform (WSL без Windows, другая ОС) — выход с ним же: присваивание под set -e.
os=$(bash "$here/platform")

if [ "$os" = linux ]; then
    script=$(mktemp)
    trap 'rm -f "$script"' EXIT
    if [[ $MEETING_RELEASES =~ ^https?:// ]]; then
        curl -fsSL --retry 3 -o "$script" "$MEETING_RELEASES/latest/download/install.sh"
    else
        cp "$MEETING_RELEASES/install.sh" "$script"
    fi
    bash "$script" --release-base "$MEETING_RELEASES"
    exit 0
fi

export WSLENV="${WSLENV:+$WSLENV:}MEETING_RELEASES"
# Git Bash переделывает похожие на путь значения переменных, когда запускает программу Windows: адрес релизов —
# как есть, как во всех скриптах скилла.
export MSYS2_ENV_CONV_EXCL="${MSYS2_ENV_CONV_EXCL:+$MSYS2_ENV_CONV_EXCL;}MEETING_"

powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command '
$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"
[Console]::OutputEncoding = [Text.Encoding]::UTF8
[Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
$releases = $env:MEETING_RELEASES
$script = Join-Path $env:TEMP "meeting-assistant-install.ps1"
if ($releases -match "^https?://") {
    Invoke-WebRequest -Uri "$releases/latest/download/install.ps1" -OutFile $script -UseBasicParsing
}
else {
    Copy-Item (Join-Path $releases "install.ps1") $script -Force
}
& powershell.exe -NoProfile -ExecutionPolicy Bypass -File $script -ReleaseBase $releases
exit $LASTEXITCODE
'
